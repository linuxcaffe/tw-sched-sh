#!/usr/bin/env bash
set -euo pipefail

# ============================================================================
# resched - Installer Script
# Version: 1.0.0
# Generated by make-awesome.py
# ============================================================================

VERSION="1.0.0"
APPNAME="resched"
BASE_URL="https://raw.githubusercontent.com/linuxcaffe/tw-sched-sh/master"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

tw_msg() { echo -e "${BLUE}[tw]${NC} $*"; }
tw_success() { echo -e "${GREEN}[tw] [OK]${NC} $*"; }
tw_error() { echo -e "${RED}[tw] [FAIL]${NC} $*" >&2; }

# Debug support
DEBUG_LEVEL="${TW_DEBUG:-0}"
debug_msg() {
    local msg="$1"
    local level="${2:-1}"
    if [[ $DEBUG_LEVEL -ge $level ]]; then
        echo -e "${BLUE}[DEBUG-$level]${NC} $msg" >&2
    fi
}

debug_msg "Starting installer with DEBUG_LEVEL=$DEBUG_LEVEL" 1

# Directories
HOME="${HOME:-$(eval echo ~$USER)}"
TASKRC="${TASKRC:-${HOME}/.taskrc}"
TASK_DIR="${TW_TASK_DIR:-${HOME}/.task}"
HOOKS_DIR="${TASK_DIR}/hooks"
SCRIPTS_DIR="${TASK_DIR}/scripts"
CONFIG_DIR="${TASK_DIR}/config"
DOCS_DIR="${TASK_DIR}/docs"
MAN_DIR="${DOCS_DIR}/man"

# ============================================================================
# Installation Function
# ============================================================================

install() {
    tw_msg "Installing resched v$VERSION..."
    debug_msg "Starting installation" 1

    # Create directories
    tw_msg "Creating directories..."
    mkdir -p "$HOOKS_DIR" "$SCRIPTS_DIR" "$CONFIG_DIR" "$DOCS_DIR"
    debug_msg "Directories created" 2

    tw_msg "Downloading files..."
    debug_msg "Using BASE_URL: $BASE_URL" 2

    debug_msg "Downloading script: tsch.sh" 2
    curl -fsSL "$BASE_URL/tsch.sh" -o "$SCRIPTS_DIR/tsch.sh" || {
        tw_error "Failed to download tsch.sh"
        debug_msg "Download failed: tsch.sh" 1
        return 1
    }
    chmod +x "$SCRIPTS_DIR/tsch.sh"
    debug_msg "Installed script: $SCRIPTS_DIR/tsch.sh" 2

    debug_msg "Downloading config: sched.rc" 2
    curl -fsSL "$BASE_URL/sched.rc" -o "$CONFIG_DIR/sched.rc.new" || {
        rm -f "$CONFIG_DIR/sched.rc.new"
        tw_error "Failed to download sched.rc"
        debug_msg "Download failed: sched.rc" 1
        return 1
    }
    if [[ ! -f "$CONFIG_DIR/sched.rc" ]]; then
        mv "$CONFIG_DIR/sched.rc.new" "$CONFIG_DIR/sched.rc"
        debug_msg "Installed config: $CONFIG_DIR/sched.rc" 2
    elif cmp -s "$CONFIG_DIR/sched.rc" "$CONFIG_DIR/sched.rc.new"; then
        rm -f "$CONFIG_DIR/sched.rc.new"
    else
        tw_msg "Kept your sched.rc; the new default is sched.rc.new"
    fi

    INCLUDED_RC="${TASK_DIR}/config/included.rc"
    # sched.rc is included: taskwarrior reads it
    if [ "$TASK_DIR" = "$HOME/.task" ]; then
        INC_PATH="~/.task/config/sched.rc"
    else
        INC_PATH="${TASK_DIR}/config/sched.rc"
    fi
    if grep -qE "^[[:space:]]*include[[:space:]].*/sched\.rc([[:space:]]|$)" "$TASKRC" "$INCLUDED_RC" 2>/dev/null; then
        tw_msg "Config already included: sched.rc"
    elif grep -qE "^[[:space:]]*#[[:space:]]*include[[:space:]].*/sched\.rc([[:space:]]|$)" "$INCLUDED_RC" 2>/dev/null; then
        sed -i.bak -E "s|^[[:space:]]*#[[:space:]]*(include[[:space:]].*/sched\.rc)([[:space:]].*)?$|\1|" "$INCLUDED_RC"
        tw_msg "Re-enabled config include in included.rc: sched.rc"
    elif [ -f "$INCLUDED_RC" ]; then
        echo "include $INC_PATH" >> "$INCLUDED_RC"
        tw_msg "Added config include to included.rc: sched.rc"
    else
        echo "include $INC_PATH" >> "$TASKRC"
        tw_msg "Added config include to .taskrc: sched.rc"
    fi

    tw_msg "Downloading documentation..."
    curl -fsSL "$BASE_URL/README.md" -o "$DOCS_DIR/resched_README.md" 2>/dev/null || true
    debug_msg "Downloaded doc: $DOCS_DIR/resched_README.md" 2

    # Track in manifest
    debug_msg "Writing to manifest" 2
    MANIFEST_FILE="${HOME}/.task/config/.tw_manifest"
    TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    mkdir -p "$(dirname "$MANIFEST_FILE")"

    echo "$APPNAME|$VERSION|$SCRIPTS_DIR/tsch.sh||$TIMESTAMP" >> "$MANIFEST_FILE"
    debug_msg "Manifest entry: $SCRIPTS_DIR/tsch.sh" 3
    echo "$APPNAME|$VERSION|$CONFIG_DIR/sched.rc||$TIMESTAMP" >> "$MANIFEST_FILE"
    debug_msg "Manifest entry: $CONFIG_DIR/sched.rc" 3
    echo "$APPNAME|$VERSION|$DOCS_DIR/resched_README.md||$TIMESTAMP" >> "$MANIFEST_FILE"
    debug_msg "Manifest entry: $DOCS_DIR/resched_README.md" 3

    debug_msg "Installation complete" 1
    tw_success "Installed resched v$VERSION"
    echo ""
    tw_msg "Documentation: $DOCS_DIR/resched_README.md"
    echo ""

    return 0
}

# ============================================================================
# Removal Function
# ============================================================================

remove() {
    tw_msg "Removing resched..."
    debug_msg "Starting removal" 1

    MANIFEST_FILE="${HOME}/.task/config/.tw_manifest"
    if [ ! -f "$MANIFEST_FILE" ]; then
        tw_error "Manifest file not found"
        return 1
    fi

    # Remove files based on manifest
    grep "^$APPNAME|" "$MANIFEST_FILE" | cut -d"|" -f3 | while read -r file; do
        if [ -f "$file" ] || [ -L "$file" ]; then   # -L: a link, even dangling
            rm "$file"
            debug_msg "Removed: $file" 2
            tw_msg "Removed: $(basename $file)"
        fi
    done

    # Remove from manifest
    sed -i.bak "/^$APPNAME|/d" "$MANIFEST_FILE"
    debug_msg "Removed from manifest" 2

    # Remove config includes from included.rc and .taskrc
    INCLUDED_RC="${TASK_DIR}/config/included.rc"
    for rcfile in "$INCLUDED_RC" "$TASKRC"; do
        if grep -qE "^[[:space:]]*#?[[:space:]]*include[[:space:]].*/sched\.rc([[:space:]]|$)" "$rcfile" 2>/dev/null; then
            sed -i.bak -E "\%^[[:space:]]*#?[[:space:]]*include[[:space:]].*/sched\.rc([[:space:]]|$)%d" "$rcfile"
            tw_msg "Removed include of sched.rc from $(basename "$rcfile")"
        fi
    done

    tw_success "Removed resched"
    return 0
}

# ============================================================================
# Main
# ============================================================================

case "${1:-install}" in
    install)
        install
        ;;
    remove|uninstall)
        remove
        ;;
    *)
        echo "Usage: $0 {install|remove}"
        exit 1
        ;;
esac
